# ─────────────────────────────────────────────────────────────
# TRAVELXPLORER — FRONTEND ENVIRONMENT
# nextjs-template/.env.local
#
# This file is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# BACKEND API
# ─────────────────────────────────────────────
# URL of the running Express API (api/ project).
# In development this is the local server; in production point to your deployed API.
# NEXT_PUBLIC_* vars are exposed to the browser — keep this to the public API base only.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─────────────────────────────────────────────
# APP — PUBLIC
# ─────────────────────────────────────────────
# Canonical URL of this Next.js app.
# Used for absolute links (e.g. OG meta tags, canonical hrefs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Human-readable application name shown in page titles, emails, etc.
NEXT_PUBLIC_APP_NAME=TravelXplorer
